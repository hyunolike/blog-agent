# NVIDIA API 카탈로그 키 (https://build.nvidia.com 에서 발급, nvapi- 로 시작)
NVIDIA_API_KEY=
# 쉼표로 구분한 답변 모델. 첫 번째가 기본이고, 두 번째는 첫 번째가 실패하거나 8초 안에 답을 시작하지 못할 때 넘겨받는다
CHAT_MODELS=
# 인덱스를 만들 때 쓰는 임베딩 모델 (채팅은 인덱스에 기록된 모델을 따른다)
EMBEDDING_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v1
# 배포된 채팅 서버 주소 (끝에 / 없이)
APP_ORIGIN=http://localhost:3000
# /embed를 iframe으로 띄울 수 있는 곳 (공백 구분)
FRAME_ANCESTORS='self' http://localhost:3000 https://hyunolike.tistory.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
