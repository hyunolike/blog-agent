# NVIDIA API 카탈로그 키 (https://build.nvidia.com 에서 발급, nvapi- 로 시작)
NVIDIA_API_KEY=
# 쉼표로 구분한 답변 모델. 첫 번째가 기본이고, 두 번째는 첫 번째가 실패하거나 8초 안에 답을 시작하지 못할 때 넘겨받는다
CHAT_MODELS=nvidia/nemotron-3.5-lightning-30b-a3b,nvidia/nemotron-3.5-bolt-e4b
# 인덱스를 만들 때 쓰는 임베딩 모델 (채팅은 인덱스에 기록된 모델을 따른다)
EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b
# 배포된 채팅 서버 주소 (끝에 / 없이)
APP_ORIGIN=http://localhost:3000
# /embed를 iframe으로 띄울 수 있는 곳 (공백 구분)
FRAME_ANCESTORS='self' http://localhost:3000 https://hyunolike.tistory.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 평가 검토 화면(/admin). 넷 중 하나라도 없으면 관리자 경로는 404다.
# GitHub OAuth App의 Callback URL은 ${APP_ORIGIN}/api/admin/callback (로컬은 http://localhost:3000/api/admin/callback으로 앱을 따로 만든다)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 32자 이상 임의 문자열 (openssl rand -base64 48). 바꾸면 모든 관리자 세션이 끊긴다
ADMIN_SESSION_SECRET=
# 들어올 수 있는 GitHub 숫자 사용자 ID, 쉼표 구분 (gh api user --jq .id)
ADMIN_GITHUB_IDS=
